{
  "agent_type": "openclaw",
  "agent_version": "2026.4.26",
  "exclude": [
    "*.bak*",
    "*.backup*",
    "*.clobbered.*",
    "*.last-good",
    "agents/*/sessions/",
    "browser/",
    "clawdbot.json",
    "completions/",
    "cron/runs/",
    "delivery-queue/",
    "devices/pending.json",
    "extensions/",
    "logs/",
    "*.sqlite-wal",
    "*.sqlite-shm",
    "memory/lancedb.bak*/",
    "nodes/pending.json",
    "plugin-runtime-deps/",
    "plugin-runtimes/",
    "qqbot/",
    "workspace"
  ],
  "items": [
    {
      "kind": "secret",
      "source": "identity/device.json"
    },
    {
      "kind": "secret",
      "source": "identity/device-auth.json"
    },
    {
      "kind": "secret",
      "source": "credentials/github-copilot.token.json"
    },
    {
      "kind": "secret",
      "source": "agents/*/agent/auth-profiles.json"
    },
    {
      "kind": "secret",
      "source": "devices/paired.json"
    },
    {
      "kind": "secret",
      "source": "nodes/paired.json"
    },
    {
      "kind": "data",
      "source": "update-check.json"
    },
    {
      "kind": "data",
      "source": "agents/*/agent/auth-state.json"
    },
    {
      "kind": "data",
      "source": "agents/*/agent/models.json"
    },
    {
      "kind": "data",
      "source": "credentials/slack-pairing.json"
    },
    {
      "kind": "data",
      "source": "credentials/slack-default-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "credentials/slack-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "credentials/telegram-pairing.json"
    },
    {
      "kind": "data",
      "source": "credentials/telegram-default-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "credentials/telegram-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "credentials/telegram-erbot-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "credentials/telegram-prepbot-allowFrom.json"
    },
    {
      "kind": "data",
      "source": "cron/jobs.json"
    },
    {
      "kind": "data",
      "source": "cron/jobs-state.json"
    },
    {
      "kind": "data",
      "source": "subagents/runs.json"
    },
    {
      "kind": "data",
      "source": "plugins/installs.json"
    },
    {
      "kind": "data",
      "source": "acpx/codex-acp-wrapper.mjs"
    },
    {
      "kind": "data",
      "source": "acpx/codex-home/config.toml"
    },
    {
      "kind": "data",
      "source": "canvas/index.html"
    },
    {
      "kind": "data",
      "source": "telegram/"
    },
    {
      "kind": "sqlite",
      "source": "memory/main.sqlite"
    },
    {
      "kind": "sqlite",
      "source": "memory/memory.db"
    },
    {
      "kind": "sqlite",
      "source": "memory/erbot.sqlite"
    },
    {
      "kind": "sqlite",
      "source": "tasks/runs.sqlite"
    },
    {
      "kind": "sqlite",
      "source": "flows/registry.sqlite"
    },
    {
      "kind": "blob",
      "source": "memory/lancedb/"
    },
    {
      "kind": "blob",
      "source": "media/inbound/"
    },
    {
      "kind": "blob",
      "source": "media/browser/"
    }
  ],
  "lifecycle": {
    "detect_running": {
      "command": [
        "sh",
        "-c",
        "curl -sSf --max-time 2 http://127.0.0.1:10001/health > /dev/null"
      ],
      "description": "OpenClaw gateway HTTP health endpoint responds on default port 10001",
      "running_exit_code": 0
    },
    "start": {
      "command": [
        "sh",
        "-c",
        "systemctl --user start openclaw-gateway 2>/dev/null || launchctl load ~/Library/LaunchAgents/openclaw.plist 2>/dev/null || echo 'Could not auto-start OpenClaw. Start manually, then run: argit doctor'"
      ],
      "description": "Start OpenClaw (same fallback chain as stop). Authors must keep this idempotent against an already-running agent (systemctl is; pkill+exec is not)."
    },
    "stop": {
      "command": [
        "sh",
        "-c",
        "systemctl --user stop openclaw-gateway 2>/dev/null || launchctl unload ~/Library/LaunchAgents/openclaw.plist 2>/dev/null || pkill -TERM -f 'openclaw.*gateway'"
      ],
      "description": "Stop OpenClaw (systemd user unit, launchd agent, or SIGTERM fallback)"
    }
  },
  "manifest_revision": 2,
  "sanitize": [
    {
      "file": "openclaw.json",
      "rules": [
        {
          "path": ".gateway.auth.token"
        },
        {
          "path": ".channels.telegram.accounts.*.botToken"
        },
        {
          "path": ".channels.slack.botToken"
        },
        {
          "path": ".channels.slack.appToken"
        },
        {
          "path": ".env",
          "subtree": true
        }
      ]
    },
    {
      "file": "exec-approvals.json",
      "rules": [
        {
          "path": ".socket.token"
        }
      ]
    }
  ],
  "schema_version": 1,
  "source_root": "~/.openclaw"
}
